# Copy this file to .env and fill in real values.
# NEXT_PUBLIC_* values are exposed to the browser (safe by design).
# Never put the Supabase service role key or any private API key in a
# NEXT_PUBLIC_* variable, and never commit the real .env file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-side only — used by the daily receipt-processing (Cowork) flow.
# Bypasses RLS, so keep it local/secret and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional integrations
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-google-analytics-id-here
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

NEXT_PUBLIC_SITE_URL=https://your-site-url.example
